
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ADDA - Connect & Share</title>
  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f0f2f5;
      color: #222;
    }
    header {
      background: #1877f2;
      color: white;
      padding: 16px;
      font-size: 26px;
      font-weight: bold;
    }
    main {
      max-width: 600px;
      margin: 20px auto;
      padding: 12px;
    }
    .card {
      background: white;
      padding: 18px;
      border-radius: 12px;
      margin-bottom: 16px;
    }
    textarea {
      box-sizing: border-box;
      width: 100%;
      min-height: 80px;
      padding: 12px;
      border: 1px solid #ddd;
      border-radius: 8px;
    }
    button {
      background: #1877f2;
      color: white;
      border: 0;
      border-radius: 8px;
      padding: 10px 18px;
      margin-top: 10px;
      cursor: pointer;
    }
    .post {
      border-top: 1px solid #eee;
      padding-top: 12px;
      margin-top: 12px;
      overflow-wrap: anywhere;
    }
  </style>
</head>
<body>
  <header>ADDA</header>
  <main>
    <section class="card">
      <h2>Welcome to ADDA!</h2>
      <p>Connect with friends and share your moments.</p>
    </section>
    <section class="card">
      <h3>Create a post</h3>
      <textarea id="postText" placeholder="What's on your mind?"></textarea>
      <button onclick="addPost()">Post</button>
    </section>
    <section class="card">
      <h3>Latest Posts</h3>
      <div id="posts">No posts yet. Be the first to share!</div>
    </section>
  </main>
  <script>
    function addPost() {
      const input = document.getElementById('postText');
      const value = input.value.trim();
      if (!value) {
        alert('Please write something first!');
        return;
      }
      const post = document.createElement('div');
      post.className = 'post';
      post.textContent = value;
      const posts = document.getElementById('posts');
      if (posts.textContent === 'No posts yet. Be the first to share!') {
        posts.textContent = '';
      }
      posts.prepend(post);
      input.value = '';
    }
  </script>
</body>
</html>
